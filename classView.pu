  + GetMass() : MathLib::HReal
  + Commit() : void
  + CreateFromMesh(options : ClothCreateOptions) : bool
  - InitializeCloth(options : ClothCreateOptions) : bool
  - CreateClothMesh(meshDesc : ClothMeshDesc) : bool
  - UpdateBoundingBox() : void
  - CreateGridMesh(width : int, height : int, spacing : MathLib::HReal) : void
  - UpdateDeformedVertices() : void
  - m_Type : PhysicsObjectType
  - m_ParticleSystem : PhysXPtr<physx::PxPBDParticleSystem>
  - m_ClothBuffer : PhysXPtr<physx::PxParticleClothBuffer>
  - m_TriangleMesh : PhysXPtr<physx::PxTriangleMesh>
  - m_PBDMaterial : PhysXPtr<physx::PxPBDMaterial>
  - m_Material : PhysicsPtr<IPhysicsMaterial>
  - m_ColliderGeometries : std::vector<PhysicsPtr<IColliderGeometry>>
  - m_ColliderLocalPos : std::vector<MathLib::HTransform3>
  - m_FixedVertices : std::vector<bool>
  - m_OriginalVertices : std::vector<MathLib::HVector3>
  - m_DeformedVertices : std::vector<MathLib::HVector3>
  - m_TriangleIndices : std::vector<uint32_t>
  - m_Params : ClothParams
  - m_Transform : MathLib::HTransform3
  - m_BoundingBox : MathLib::HAABBox3D
  - m_Width : int
  - m_Height : int
}

@enduml
